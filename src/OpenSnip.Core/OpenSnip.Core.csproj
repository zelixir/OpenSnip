<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenSnip.Core</RootNamespace>
    <!-- 红线 §0.7:类库不引用 WPF,纯 Win32 + Vortice + Skia -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPEC §4:DXGI Desktop Duplication 主路径 -->
    <!-- SkiaSharp:§2.2 冻结签名 WrapAsSkia/EncodePng 需要(§4 未列,见交付说明) -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
